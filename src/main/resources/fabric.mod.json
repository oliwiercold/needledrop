{
	"schemaVersion": 1,
	"id": "musicdiscs",
	"version": "${version}",
	"name": "Needledrop",
	"description": "Turns the songs in your local Music folder into findable, playable music discs with cover-color icons.",
	"authors": ["gimpOStin"],
	"contact": {
		"sources": "https://github.com/oliwiercold/musicdiscs"
	},
	"icon": "assets/musicdiscs/icon.png",
	"license": "CC0-1.0",
	"environment": "*",
	"entrypoints": {
		"main": ["com.musicdiscs.MusicDiscsMod"],
		"client": ["com.musicdiscs.MusicDiscsClientMod"]
	},
	"mixins": [
		"musicdiscs.mixins.json",
		"musicdiscs.client.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"fabric-api": "*"
	}
}
